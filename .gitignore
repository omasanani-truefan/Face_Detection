.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Downloaded weights and datasets: fetched + checksum-verified by scripts, never committed.
models/*
!models/.gitkeep
data/
!data/README.md

# Benchmark outputs are regenerated by scripts; the rendered tables live in docs/.
results/*/raw/
results/*/raw_*/
results/tracking/detections/
results/tracking_smoke/
results/demo/

# Frames from third-party videos / photos: regenerate locally, never commit.
results/youtube/*.jpg
docs/images/detections_grid.jpg

.DS_Store
Thumbs.db
